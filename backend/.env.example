PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/covoiturage
# true uniquement en développement / tests : en recette et production, utiliser les migrations
DB_SYNCHRONIZE=false
DB_RUN_MIGRATIONS=true
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
# console | (fournisseurs réels à brancher, séparés par des virgules pour la bascule)
SMS_PROVIDERS=console
